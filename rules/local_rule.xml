<!-- Detect the powershell execution (T1059.001) -->
</rule>
  <rule id="100100" level="7">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe$</field>
    <description>Powershell process execution detected via Sysmon</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>sysmon,powershell,windows,</group>
  </rule>

<!-- Detect the suspicious powershell command line execution (T1059.001) -->
<rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc|-windowstyle hidden|-w hidden)</field>
    <description>Suspicious Powershell command-line arguments detected</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>sysmon,powershell,suspicious_activity,</group>
    <options>no_full_log</options>
  </rule>
</group>
